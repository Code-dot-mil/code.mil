#!/usr/bin/env bash
set -e # halt script on error

bundle exec jekyll build
mkdocs build -f ai4sdlc-mkdocs.yml --site-dir public/AI4SDLC --quiet
# Government and some other sites block automated requests with 403; ignore them.
# code.mil self-references are canonical/sitemap links generated by MkDocs; ignore them too.
#
# The OSS FAQ is excluded for the same reason AI4SDLC is: it is maintained in
# its own repository and link-checked there. It carries roughly 205 links across
# some 60 .mil and .gov hosts, many of which reject non-browser user agents,
# sit behind CAC/PKI, or return soft 404s -- a 200 with an empty body. Checking
# it usefully needs a realistic user agent and content inspection rather than
# status codes alone, which is more than this site-wide sweep is set up to do.
# The pattern matches both the page (/oss-faq.html) and its assets (/oss-faq/).
bundle exec htmlproofer ./public --timeframe 6w \
  --file-ignore "/\/AI4SDLC\//,/oss-faq/" \
  --url-ignore "/^mailto:/,/code\.mil\//,/code.gov\/about\/open-source\/introduction/,/code.gov\/about\/compliance\/inventory-code/,/twitter.com\/DefenseDigital/,/dodcio\.defense\.gov/,/www\.defense\.gov/,/media\.defense\.gov/,/www\.esd\.whs\.mil/,/platform\.openai\.com/,/fonts\.gstatic\.com/"
